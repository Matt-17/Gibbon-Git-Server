@model RepositoryCloneModel
@inject Gibbon.Git.Server.Services.ICloneToolService CloneToolService
@{
    var tools = CloneToolService.GetAvailableTools();
    var preferred = CloneToolService.GetPreferredTool();
    var toolUrl = Model.PersonalGitUrl ?? Model.GitUrl;
}
<div class="clone-panel">
    <div class="clone-url">
        <label>@Resources.Repository_Detail_Location</label>
        <input type="text" readonly="readonly" value="@Model.GitUrl" class="git-url-text" onclick="this.select()" />
        <button type="button" class="pure-button copy-to-clip-button" data-clipboard-text="@Model.GitUrl"><i class="fa fa-copy"></i></button>
    </div>
    @if (Model.PersonalGitUrl != null)
    {
        <div class="clone-url">
            <label>@Resources.Repository_Detail_Location_Personal</label>
            <input type="text" readonly="readonly" value="@Model.PersonalGitUrl" class="personal-url-text" onclick="this.select()" />
            <button type="button" class="pure-button copy-to-clip-button" data-clipboard-text="@Model.PersonalGitUrl"><i class="fa fa-copy"></i></button>
        </div>
    }
    <div class="clone-actions">
        @if (preferred != null)
        {
            <a class="pure-button pure-button-primary clone-preferred" href="@preferred.BuildUrl(toolUrl)">@string.Format(Resources.Repository_ClonePanel_OpenIn, preferred.Name)</a>
        }
        @if (tools.Count > 0)
        {
            <details class="clone-tools">
                <summary class="pure-button"><i class="fa fa-external-link"></i> @Resources.Repository_ClonePanel_OpenWith</summary>
                <ul>
                    @foreach (var tool in tools)
                    {
                        <li><a href="@tool.BuildUrl(toolUrl)">@tool.Name</a></li>
                    }
                </ul>
            </details>
        }
        <button type="button" class="pure-button copy-to-clip-button" data-clipboard-text="git clone @toolUrl"><i class="fa fa-terminal"></i> @Resources.Repository_ClonePanel_Command</button>
        <a class="pure-button" href="@Url.Action("Download", "Repositories", new { name = Model.Name })" download><i class="fa fa-download"></i> @Resources.Repository_Tree_Zip</a>
    </div>
</div>
