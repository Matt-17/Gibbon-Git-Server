@using Gibbon.Git.Server.Security
@model TeamDetailModel
@{
    ViewBag.Title = Resources.Team_Detail_Title;
}
@if (Model == null)
{
    @await Html.PartialAsync("~/Views/Shared/_ItemNotFound.cshtml")
    return;
}
<h1>@Model.Name</h1>

<div class="pure-form pure-form-aligned detail">
    <fieldset>
        <div class="pure-control-group">
            @Html.LabelFor(m => m.Name)
            <span>@Model.Name</span>
        </div>
        <div class="pure-control-group">
            @Html.LabelFor(m => m.Description)
            <span>@Model.Description</span>
        </div>
        <div class="pure-control-group">
            @Html.LabelFor(m => m.Members)
            <span>
                @{ var sortedMembers = NameFormatter.Sort(Model.Members).ToList(); }
                @foreach (var member in sortedMembers)
                {
                    if (member != sortedMembers.First())
                    {
                        @Html.Raw(" &bull; ")
                    }
                    @Html.ActionLink(NameFormatter.GetDisplayName(member), "Detail", "Users", new { username = member.Username }, new { title = member.Username })
                }
            </span>
        </div>
        <div class="pure-control-group">
            @Html.LabelFor(m => m.Repositories)
            <span>
                @foreach (var repository in Model.Repositories)
                {
                    if (repository != Model.Repositories.First())
                    {
                        @Html.Raw(" &bull; ")
                    }
                    @Html.ActionLink(repository.Name, "Detail", "Repositories", new { name = repository.Name }, null)
                }
            </span>
        </div>
        <div class="pure-controls">
            <a class="pure-button" href="@Url.Action("Index")">
                <i class="fa fa-long-arrow-left"></i> @Resources.Team_Detail_Back
            </a>
            @if (User.IsInRole(Roles.Admin))
            {
                <a class="pure-button" href="@Url.Action("Edit", new { teamname = Model.Name })">
                    <i class="fa fa-pencil-square-o"></i> @Resources.Team_Detail_Edit
                </a>
                <a class="pure-button" href="@Url.Action("Delete", new { teamname = Model.Name })">
                    <i class="fa fa-trash-o"></i> @Resources.Team_Detail_Delete
                </a>
            }
        </div>
    </fieldset>
</div>
