<Project Sdk="Microsoft.NET.Sdk.Web">

	<ItemGroup>
		<InternalsVisibleTo Include="Gibbon.Git.Server.Tests" />
		<InternalsVisibleTo Include="Gibbon.Git.Server.Integration.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.SassCompiler" />
		<PackageReference Include="MailKit" />
		<PackageReference Include="Markdig" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="MimeKit" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="SharpZipLib" />
		<PackageReference Include="LibGit2Sharp" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="MimeTypes">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
		<PackageReference Include="Ude.NetStandard" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="App_Resources\Resources.resx">
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>Gibbon.Git.Server.App_Resources</StronglyTypedNamespace>
			<StronglyTypedClassName>Resources</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Native packages such as SkiaSharp ship debug symbols of about 90 MB per platform; they are not needed at runtime. -->
	<Target Name="RemoveNativeDebugSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(RelativePath)').StartsWith('runtimes'))" />
		</ItemGroup>
	</Target>

</Project>
