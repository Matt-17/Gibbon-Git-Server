<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<Title>Gibbon Git Server</Title>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<RazorCompileOnBuild>true</RazorCompileOnBuild>
		<RazorCompileOnPublish>true</RazorCompileOnPublish>
		<PreserveCompilationContext>true</PreserveCompilationContext>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Gibbon.Git.Server.Tests" />
		<InternalsVisibleTo Include="Gibbon.Git.Server.Integration.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="App_Data\.gitconfig" />
		<None Remove="App_Data\Git\*" />
		<None Remove="App_Data\Repositories\note.txt" />
		<None Remove="Monikers.imagemanifest" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Styles\fonts.scss" />
		<Content Include="Styles\site.scss" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AspNetCore.SassCompiler" />
		<PackageReference Include="MailKit" />
		<PackageReference Include="Markdig" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="MimeKit" />
		<PackageReference Include="Serilog.Extensions.Logging" />
		<PackageReference Include="Serilog.Sinks.File" />
		<PackageReference Include="SharpZipLib" />
		<PackageReference Include="LibGit2Sharp" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="MimeTypes">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SkiaSharp" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
		<PackageReference Include="Ude.NetStandard" />
	</ItemGroup>

	<ItemGroup>
		<!-- The Resources class is generated during the build, so no Designer.cs is checked in. -->
		<EmbeddedResource Update="App_Resources\Resources.resx">
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>Gibbon.Git.Server.App_Resources</StronglyTypedNamespace>
			<StronglyTypedClassName>Resources</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)Resources.Designer.cs</StronglyTypedFileName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <UpToDateCheckInput Remove="Styles\site.scss" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="wwwroot\lib\css\font-awesome.css">
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Update="wwwroot\lib\css\font-awesome.css.map">
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	  <Content Update="wwwroot\lib\css\font-awesome.min.css">
	    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
	  <None Update="App_Data\note.txt">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
